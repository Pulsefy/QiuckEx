{
  "name": "@quickex/backend",
  "version": "0.1.0",
  "private": true,
  "description": "QuickEx NestJS backend API",
  "dependencies": {
    "@nestjs/common": "^11.2.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.1",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/platform-express": "^11.2.1",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.5.0",
    "@sentry/nestjs": "^10.70.0",
    "@sentry/node": "^10.70.0",
    "@sentry/profiling-node": "^10.70.0",
    "@stellar/stellar-sdk": "^17.0.0",
    "@supabase/supabase-js": "^2.112.3",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "helmet": "^8.3.0",
    "ipaddr.js": "^2.5.0",
    "joi": "^18.2.5",
    "lru-cache": "^11.5.2",
    "nest-winston": "^1.10.2",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "telegraf": "^4.16.3",
    "uuid": "^14.0.2",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^11.0.0",
    "@types/yargs": "^17.0.35",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^10.9.0",
    "fast-check": "^4.9.0",
    "jest": "^30.4.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.0",
    "typescript": "^7.0.2"
  },
  "pnpm": {
    "neverBuiltDependencies": [
      "unrs-resolver"
    ]
  },
  "scripts": {
    "dev": "nest start --watch",
    "start:dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "type-check": "tsc --noEmit",
    "test": "jest --config jest.config.ts",
    "test:unit": "jest --config jest.unit.config.ts",
    "test:unit:coverage": "jest --config jest.unit.config.ts --coverage",
    "test:int": "jest --config jest.int.config.ts",
    "test:int:coverage": "jest --config jest.int.config.ts --coverage",
    "test:e2e": "jest --config jest.e2e.config.ts",
    "soroban:deploy": "ts-node scripts/soroban-deploy.ts",
    "test:fuzz": "jest --config jest.fuzz.config.ts",
    "test:fuzz:ci": "jest --config jest.fuzz.config.ts --runInBand",
    "test:smoke": "jest --config jest.e2e.config.ts test/smoke.e2e-spec.ts --testTimeout=30000",
    "test:smoke:soroban": "jest --config jest.e2e.config.ts test/smoke-soroban-horizon.e2e-spec.ts --testTimeout=30000",
    "test:smoke:all": "jest --config jest.e2e.config.ts test/smoke*.e2e-spec.ts --testTimeout=30000"
  }
}
