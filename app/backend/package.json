{
  "name": "@quickex/backend",
  "version": "0.1.0",
  "private": true,
  "description": "QuickEx NestJS backend API",
  "dependencies": {
    "@nestjs/common": "^12.1.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/instrumentation-express": "^0.70.0",
    "@opentelemetry/instrumentation-http": "^0.222.0",
    "@opentelemetry/instrumentation-nestjs-core": "^0.68.0",
    "@opentelemetry/instrumentation-undici": "^0.32.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.0",
    "@nestjs/event-emitter": "^12.0.1",
    "@nestjs/platform-express": "^12.1.0",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/throttler": "^6.7.1",
    "@sentry/nestjs": "^11.0.0",
    "@sentry/node": "^11.0.0",
    "@sentry/profiling-node": "^11.0.0",
    "@stellar/stellar-sdk": "^17.1.0",
    "@supabase/supabase-js": "^2.117.2",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "helmet": "^8.3.0",
    "ipaddr.js": "^2.5.0",
    "joi": "^18.2.9",
    "lru-cache": "^11.5.3",
    "nest-winston": "^2.0.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "telegraf": "^4.16.3",
    "uuid": "^14.0.2",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.7",
    "@nestjs/testing": "^12.1.0",
    "@opentelemetry/context-async-hooks": "^2.10.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.3",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^11.0.0",
    "@types/yargs": "^17.0.35",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "eslint": "^10.11.0",
    "fast-check": "^4.10.2",
    "jest": "^30.5.2",
    "supertest": "^7.3.0",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.0",
    "typescript": "^7.0.2"
  },
  "pnpm": {
    "neverBuiltDependencies": [
      "unrs-resolver"
    ]
  },
  "scripts": {
    "dev": "nest start --watch",
    "start:dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main",
    "lint": "eslint \"{src,test,perf}/**/*.ts\"",
    "type-check": "tsc --noEmit",
    "check:routes": "ts-node scripts/check-route-conventions.ts",
    "test": "jest --config jest.config.ts",
    "test:unit": "jest --config jest.unit.config.ts",
    "test:unit:coverage": "jest --config jest.unit.config.ts --coverage",
    "test:int": "jest --config jest.int.config.ts",
    "test:int:coverage": "jest --config jest.int.config.ts --coverage",
    "test:e2e": "jest --config jest.e2e.config.ts",
    "soroban:deploy": "ts-node scripts/soroban-deploy.ts",
    "test:fuzz": "jest --config jest.fuzz.config.ts",
    "test:fuzz:ci": "jest --config jest.fuzz.config.ts --runInBand",
    "test:smoke": "jest --config jest.e2e.config.ts test/smoke.e2e-spec.ts --testTimeout=30000",
    "test:smoke:soroban": "jest --config jest.e2e.config.ts test/smoke-soroban-horizon.e2e-spec.ts --testTimeout=30000",
    "test:smoke:all": "jest --config jest.e2e.config.ts test/smoke*.e2e-spec.ts --testTimeout=30000",
    "perf:load": "ts-node perf/load-harness.ts"
  }
}
