{
  "name": "@quickex/api-client",
  "version": "0.1.0",
  "private": true,
  "description": "Generated, typed API client for the QuickEx backend, produced from the OpenAPI spec.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schemas": "./src/schemas.d.ts"
  },
  "files": [
    "dist",
    "src/schemas.d.ts",
    "README.md"
  ],
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-schemas.mjs",
    "regenerate": "npm run generate && npm run build",
    "type-check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "openapi-fetch": "0.13.8"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
